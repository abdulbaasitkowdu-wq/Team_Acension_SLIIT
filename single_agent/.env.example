# PHANTOM — Single-Agent Investigation System
# Environment Configuration Example
# Copy to .env and fill in real values

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================
# Choose one of: openai, anthropic, google, ollama
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.0

# Anthropic (alternative)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Google Gemini (alternative)
GOOGLE_API_KEY=your-google-key-here
GOOGLE_MODEL=gemini-1.5-flash

# Ollama (local, no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# =============================================================================
# DATA CONFIGURATION
# =============================================================================
# Path to your preprocessed dataset directory (relative to project root)
DATA_DIR=../Data

# =============================================================================
# INVESTIGATION SETTINGS
# =============================================================================
# Maximum cases to investigate in one run (0 = no limit)
MAX_CASES_PER_RUN=50

# Anomaly detection thresholds
TEMP_EXCURSION_RATE_THRESHOLD=0.3
DUPLICATE_SERIAL_FLAG=true
MIN_ANOMALY_SEVERITY=medium

# =============================================================================
# API SETTINGS
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# =============================================================================
# OUTPUT SETTINGS
# =============================================================================
OUTPUT_DIR=outputs
SAVE_REPORTS=true
REPORT_FORMAT=json

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
